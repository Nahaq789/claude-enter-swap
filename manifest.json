{
  "manifest_version": 3,
  "name": "Claude Enter Key Swap",
  "version": "1.1",
  "description": "Enterキーで送信しないようにする",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Enter Key Swap（クリックで切替）"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
